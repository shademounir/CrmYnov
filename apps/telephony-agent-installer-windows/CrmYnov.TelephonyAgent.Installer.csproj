<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrmYnov.TelephonyAgent.Installer</AssemblyName>
    <RootNamespace>CrmYnov.TelephonyAgent.Installer</RootNamespace>
    <ApplicationIcon>..\telephony-agent-windows\Assets\agent-icon.ico</ApplicationIcon>
    <Version>0.4.9</Version>
    <AssemblyVersion>0.4.9.0</AssemblyVersion>
    <FileVersion>0.4.9.0</FileVersion>
    <InformationalVersion>0.4.9-pilot</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(AgentPackageArchive)') and Exists('$(InstallerMetadataPath)')">
    <EmbeddedResource Include="$(AgentPackageArchive)" LogicalName="AgentPackage.zip" />
    <EmbeddedResource Include="$(InstallerMetadataPath)" LogicalName="InstallerMetadata.json" />
  </ItemGroup>
  <Target Name="VerifyInstallerInputs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(AgentPackageArchive)')" Text="Set AgentPackageArchive to the verified agent package ZIP." />
    <Error Condition="!Exists('$(InstallerMetadataPath)')" Text="Set InstallerMetadataPath to the generated installer metadata JSON." />
  </Target>
</Project>
