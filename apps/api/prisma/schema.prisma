generator client {
  provider = "prisma-client-js"
}

model RolePermissionEpoch {
  id      Int    @id
  version BigInt @default(0)

  @@map("role_permission_epoch")
}

// No implicit backfill from Collaborator.teamId: responsibility is explicit.
model TeamResponsibility {
  id String @id @default(uuid()) @db.Uuid
  teamId String @map("team_id") @db.VarChar(64)
  campusId String @map("campus_id") @db.Uuid
  managerId String @map("manager_id") @db.Uuid
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  manager Collaborator @relation(fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campus CrmReference @relation(fields: [campusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([teamId, campusId, managerId])
  @@map("team_responsibilities")
}

model RolePermissionConfiguration {
  id        String @id @db.VarChar(200)
  kind      String @db.VarChar(16)
  role      String @db.VarChar(20)
  campus    String @db.VarChar(80)
  version   Int @default(0)
  versions  RolePermissionVersion[]
  @@map("role_permission_configurations")
}

model RolePermissionVersion {
  id              String @id @default(uuid()) @db.Uuid
  configurationId String @map("configuration_id") @db.VarChar(200)
  number          Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  configuration   RolePermissionConfiguration @relation(fields: [configurationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grants          RolePermissionGrant[]
  audits          RolePermissionAuditEvent[]
  @@unique([configurationId, number])
  @@map("role_permission_versions")
}

model RolePermissionGrant {
  id          String @id @default(uuid()) @db.Uuid
  versionId   String @map("version_id") @db.Uuid
  permission  String @db.VarChar(80)
  scope       String @db.VarChar(10)
  version     RolePermissionVersion @relation(fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([versionId, permission])
  @@map("role_permission_grants")
}

model RolePermissionAuditEvent {
  id          String @id @default(uuid()) @db.Uuid
  versionId   String @map("version_id") @db.Uuid
  actorId     String @map("actor_id") @db.Uuid
  actorRoles  Json @map("actor_roles")
  reason      String @db.VarChar(40)
  previous    Json
  next        Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  version     RolePermissionVersion @relation(fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([versionId, createdAt])
  @@map("role_permission_audit_events")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_probes")
}

model CrmReference {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String   @db.VarChar(24)
  code         String   @db.VarChar(120)
  label        String   @db.VarChar(120)
  scope        String   @db.VarChar(12)
  campusId     String?  @map("campus_id") @db.Uuid
  scopeKey     String   @map("scope_key") @db.VarChar(40)
  state        String   @default("ACTIVE") @db.VarChar(16)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  campus       CrmReference? @relation("ReferenceCampus", fields: [campusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scopedValues CrmReference[] @relation("ReferenceCampus")
  keys         CrmReferenceKey[]
  programs     CrmProgramAvailability[] @relation("AvailableProgram")
  availability CrmProgramAvailability[] @relation("AvailableCampus")
  tags         CrmLeadTag[]
  teamResponsibilities TeamResponsibility[]

  @@unique([kind, scopeKey, code])
  @@index([kind, state, campusId])
  @@map("crm_references")
}

// Canonical keys and explicit aliases share a namespace: no ambiguous alias can shadow a code.
model CrmReferenceKey {
  id          String @id @default(uuid()) @db.Uuid
  referenceId String @map("reference_id") @db.Uuid
  kind        String @db.VarChar(24)
  scopeKey    String @map("scope_key") @db.VarChar(40)
  key         String @db.VarChar(120)
  version     Int @default(1)
  reference   CrmReference @relation(fields: [referenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([kind, scopeKey, key])
  @@map("crm_reference_keys")
}

model CrmProgramAvailability {
  programId String @map("program_id") @db.Uuid
  campusId  String @map("campus_id") @db.Uuid
  active    Boolean @default(true)
  version   Int @default(1)
  program   CrmReference @relation("AvailableProgram", fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campus    CrmReference @relation("AvailableCampus", fields: [campusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([programId, campusId])
  @@map("crm_program_availability")
}

model CrmLeadTag {
  leadId String @map("lead_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  active Boolean @default(true)
  tag CrmReference @relation(fields: [tagId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([leadId, tagId])
  @@map("crm_lead_tags")
}

model LocalOutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String    @db.VarChar(80)
  aggregateType  String    @map("aggregate_type") @db.VarChar(48)
  aggregateId    String    @map("aggregate_id") @db.VarChar(80)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(160)
  payload        Json
  status         String    @default("PENDING") @db.VarChar(16)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by") @db.VarChar(80)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(80)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([lockedAt])
  @@map("local_outbox_events")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  campusId       String?  @map("campus_id") @db.VarChar(64)
  resourceType   String?  @map("resource_type") @db.VarChar(40)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  eventType      String   @map("event_type") @db.VarChar(80)
  actorId        String?  @map("actor_id") @db.VarChar(64)
  actorRoles     String[] @map("actor_roles")
  minimizedIp    String?  @map("minimized_ip") @db.VarChar(64)
  sessionId      String?  @map("session_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.VarChar(64)
  before         Json?
  after          Json?
  result         String   @db.VarChar(32)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([campusId, occurredAt(sort: Desc), id])
  @@index([resourceId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model InternalNotification {
  id               String    @id @default(uuid()) @db.Uuid
  recipientId      String    @map("recipient_id") @db.VarChar(64)
  type             String    @db.VarChar(40)
  priority         String    @db.VarChar(16)
  resourceType     String    @map("resource_type") @db.VarChar(40)
  resourceId       String    @map("resource_id") @db.VarChar(64)
  href             String    @db.VarChar(320)
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(160)
  fingerprint      String    @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("internal_notifications")
}

model Collaborator {
  id                    String                   @id @default(uuid()) @db.Uuid
  professionalDisplayName String?                 @map("professional_display_name") @db.VarChar(120)
  professionalEmail     String                   @unique @map("professional_email") @db.VarChar(254)
  secondaryEmail        String?                  @map("secondary_email") @db.VarChar(254)
  roles                 String[]
  campusId              String?                  @map("campus_id") @db.VarChar(64)
  teamId                String?                  @map("team_id") @db.VarChar(64)
  active                Boolean                  @default(true)
  firstLoginRequired    Boolean                  @default(true) @map("first_login_required")
  authenticationVersion Int                      @default(1) @map("authentication_version")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  passwordHash          LocalPasswordHash?
  sessions              LocalSession[]
  recoveryChallenges    LocalRecoveryChallenge[]
  teamResponsibilities TeamResponsibility[]
  telephonyProfile     TelephonyUserProfile?

  @@index([active, campusId, teamId])
  @@map("collaborators")
}

model LocalPasswordHash {
  id             String       @id @default(uuid()) @db.Uuid
  collaboratorId String       @unique @map("collaborator_id") @db.Uuid
  identityDigest String       @unique @map("identity_digest") @db.VarChar(64)
  passwordSalt   String       @map("password_salt") @db.VarChar(64)
  passwordDigest String       @map("password_digest") @db.VarChar(128)
  mustChange     Boolean      @default(true) @map("must_change")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@map("local_password_hashes")
}

model LocalSession {
  id                    String       @id @db.Uuid
  collaboratorId        String       @map("collaborator_id") @db.Uuid
  tokenDigest           String       @unique @map("token_digest") @db.VarChar(64)
  roles                 String[]
  scopes                Json
  authenticationVersion Int          @map("authentication_version")
  active                Boolean      @default(true)
  expiresAt             DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  collaborator          Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@index([collaboratorId, active, expiresAt])
  @@map("local_sessions")
}

model LocalRecoveryChallenge {
  id             String       @id @default(uuid()) @db.Uuid
  collaboratorId String       @map("collaborator_id") @db.Uuid
  tokenDigest    String       @unique @map("token_digest") @db.VarChar(64)
  returnPath     String       @map("return_path") @db.VarChar(160)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@index([collaboratorId, expiresAt])
  @@map("local_recovery_challenges")
}

model Broadcast {
  id             String               @id @default(uuid()) @db.Uuid
  title          String               @db.VarChar(120)
  content        String               @db.VarChar(4000)
  internalLink   String?              @map("internal_link") @db.VarChar(500)
  authorId       String               @map("author_id") @db.VarChar(64)
  state          String               @db.VarChar(24)
  version        Int                  @default(1)
  audience       Json
  recipientCount Int                  @default(0) @map("recipient_count")
  correctionOf   String?              @map("correction_of") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  recipients     BroadcastRecipient[]

  @@index([createdAt(sort: Desc), id])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([correctionOf])
  @@map("broadcasts")
}

model BroadcastRecipient {
  broadcastId String    @map("broadcast_id") @db.Uuid
  userId      String    @map("user_id") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id])

  @@id([broadcastId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("broadcast_recipients")
}

model ChatConversation {
  id             String            @id @default(uuid()) @db.Uuid
  type           String            @db.VarChar(24)
  title          String?           @db.VarChar(120)
  leadId         String?           @map("lead_id") @db.Uuid
  leadCode       String?           @map("lead_code") @db.VarChar(32)
  createdById    String            @map("created_by_id") @db.VarChar(64)
  retentionUntil DateTime          @map("retention_until") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants   ChatParticipant[]
  messages       ChatMessage[]
  readReceipts   ChatReadReceipt[]

  @@index([updatedAt(sort: Desc), id])
  @@index([leadId, updatedAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatParticipant {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.VarChar(64)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(6)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("chat_participants")
}

model ChatMessage {
  id                 String                  @id @default(uuid()) @db.Uuid
  conversationId     String                  @map("conversation_id") @db.Uuid
  authorId           String                  @map("author_id") @db.VarChar(64)
  content            String?                 @db.VarChar(2000)
  version            Int                     @default(1)
  editedAt           DateTime?               @map("edited_at") @db.Timestamptz(6)
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation       ChatConversation        @relation(fields: [conversationId], references: [id])
  versions           ChatMessageVersion[]
  mentions           ChatMention[]
  activityConversion ChatActivityConversion?

  @@index([conversationId, createdAt, id])
  @@map("chat_messages")
}

model ChatMention {
  messageId String      @map("message_id") @db.Uuid
  userId    String      @map("user_id") @db.VarChar(64)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  message   ChatMessage @relation(fields: [messageId], references: [id])

  @@id([messageId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_mentions")
}

model ChatActivityConversion {
  id          String      @id @default(uuid()) @db.Uuid
  messageId   String      @unique @map("message_id") @db.Uuid
  leadId      String      @map("lead_id") @db.Uuid
  activityId  String      @unique @map("activity_id") @db.Uuid
  convertedBy String      @map("converted_by") @db.VarChar(64)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  message     ChatMessage @relation(fields: [messageId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@map("chat_activity_conversions")
}

model ChatMessageVersion {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  version   Int
  content   String?     @db.VarChar(2000)
  changedBy String      @map("changed_by") @db.VarChar(64)
  change    String      @db.VarChar(16)
  reason    String?     @db.VarChar(240)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  message   ChatMessage @relation(fields: [messageId], references: [id])

  @@unique([messageId, version])
  @@map("chat_message_versions")
}

model ChatReadReceipt {
  conversationId    String           @map("conversation_id") @db.Uuid
  userId            String           @map("user_id") @db.VarChar(64)
  lastReadMessageId String?          @map("last_read_message_id") @db.Uuid
  readAt            DateTime         @map("read_at") @db.Timestamptz(6)
  conversation      ChatConversation @relation(fields: [conversationId], references: [id])

  @@id([conversationId, userId])
  @@index([userId, readAt(sort: Desc)])
  @@map("chat_read_receipts")
}

model Lead {
  governedTags CrmLeadTag[]
  id                     String                           @id @default(uuid()) @db.Uuid
  leadCode               String                           @unique @map("lead_code") @db.VarChar(32)
  firstName              String                           @map("first_name") @db.VarChar(100)
  lastName               String                           @map("last_name") @db.VarChar(100)
  email                  String?                          @db.VarChar(254)
  phone                  String?                          @db.VarChar(32)
  campus                 String                           @db.VarChar(80)
  campaign               String                           @db.VarChar(120)
  educationLevel         String                           @map("education_level") @db.VarChar(80)
  program                String                           @db.VarChar(120)
  source                 String                           @db.VarChar(80)
  status                 String                           @default("PROSPECT") @db.VarChar(24)
  assignedToId           String?                          @map("assigned_to_id") @db.Uuid
  assignmentMode         String?                          @map("assignment_mode") @db.VarChar(32)
  importBatchId          String?                          @map("import_batch_id") @db.VarChar(64)
  nextActionAt           DateTime?                        @map("next_action_at") @db.Timestamptz(6)
  lastActivityAt         DateTime?                        @map("last_activity_at") @db.Timestamptz(6)
  version                Int                              @default(1)
  createdAt              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities             LeadActivity[]
  assignmentBatchItems   AssignmentBatchItem[]
  reassignmentRequests   ReassignmentRequest[]
  collaborationRequests  LeadCollaborationRequest[]
  closureRequests        LeadClosureRequest[]
  mutationReceipts       LeadMutationReceipt[]
  collaborators          LeadCollaborator[]
  provenances            LeadProvenance[]
  ingestionReviewItems   IngestionReviewItem[]
  documentChecklistItems CandidateDocumentChecklistItem[]
  documents              CandidateDocument[]
  telephonyCalls         TelephonyCall[]
  appointments           Appointment[]
  commercialQualifications LeadCommercialQualification[]
  followUps                LeadFollowUp[]

  @@index([assignedToId, status])
  @@index([assignmentMode, importBatchId])
  @@index([status, nextActionAt])
  @@index([lastName, firstName, leadCode])
  @@index([source, program, createdAt])
  @@map("leads")
}

model LeadCommercialQualification {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  temperature    String   @db.VarChar(16)
  reason         String   @db.VarChar(240)
  comment        String?  @db.VarChar(1000)
  authorId       String   @map("author_id") @db.VarChar(64)
  version        Int
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  fingerprint    String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([leadId, version])
  @@index([leadId, createdAt(sort: Desc), id])
  @@index([temperature, createdAt(sort: Desc)])
  @@map("lead_commercial_qualifications")
}

model LeadFollowUp {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  dueAt          DateTime @map("due_at") @db.Timestamptz(6)
  state          String   @db.VarChar(16)
  reason         String   @db.VarChar(1000)
  version        Int      @default(1)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  fingerprint    String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mutationReceipts LeadFollowUpMutationReceipt[]

  @@index([leadId, state, dueAt])
  @@index([ownerId, state, dueAt])
  @@map("lead_follow_ups")
}

model LeadFollowUpMutationReceipt {
  idempotencyKey String       @id @map("idempotency_key") @db.VarChar(128)
  followUpId     String       @map("follow_up_id") @db.Uuid
  fingerprint    String       @db.VarChar(64)
  result         Json
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  followUp       LeadFollowUp @relation(fields: [followUpId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([followUpId, createdAt(sort: Desc)])
  @@map("lead_follow_up_mutation_receipts")
}

model SavedLeadView {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.VarChar(64)
  name      String   @db.VarChar(80)
  filters   Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  shares SavedLeadViewShare[]

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("saved_lead_views")
}

model SavedLeadViewShare {
  id String @id @default(uuid()) @db.Uuid
  viewId String @map("view_id") @db.Uuid
  audienceKey String @map("audience_key") @db.VarChar(80)
  kind String @db.VarChar(10)
  campusId String @map("campus_id") @db.Uuid
  responsibilityId String? @map("responsibility_id") @db.Uuid
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  view SavedLeadView @relation(fields: [viewId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([viewId, audienceKey])
  @@index([campusId, active])
