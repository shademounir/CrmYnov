generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_probes")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(80)
  actorId        String?  @map("actor_id") @db.VarChar(64)
  actorRoles     String[] @map("actor_roles")
  minimizedIp    String?  @map("minimized_ip") @db.VarChar(64)
  sessionId      String?  @map("session_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.VarChar(64)
  before         Json?
  after          Json?
  result         String   @db.VarChar(32)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model Collaborator {
  id                    String   @id @default(uuid()) @db.Uuid
  professionalEmail     String   @unique @map("professional_email") @db.VarChar(254)
  secondaryEmail        String?  @map("secondary_email") @db.VarChar(254)
  roles                 String[]
  campusId              String?  @map("campus_id") @db.VarChar(64)
  teamId                String?  @map("team_id") @db.VarChar(64)
  active                Boolean  @default(true)
  firstLoginRequired    Boolean  @default(true) @map("first_login_required")
  authenticationVersion Int      @default(1) @map("authentication_version")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, campusId, teamId])
  @@map("collaborators")
}

model Lead {
  id                   String                @id @default(uuid()) @db.Uuid
  leadCode             String                @unique @map("lead_code") @db.VarChar(32)
  firstName            String                @map("first_name") @db.VarChar(100)
  lastName             String                @map("last_name") @db.VarChar(100)
  email                String?               @db.VarChar(254)
  phone                String?               @db.VarChar(32)
  campus               String                @db.VarChar(80)
  campaign             String                @db.VarChar(120)
  educationLevel       String                @map("education_level") @db.VarChar(80)
  program              String                @db.VarChar(120)
  source               String                @db.VarChar(80)
  status               String                @default("PROSPECT") @db.VarChar(24)
  assignedToId         String?               @map("assigned_to_id") @db.Uuid
  assignmentMode       String?               @map("assignment_mode") @db.VarChar(32)
  importBatchId        String?               @map("import_batch_id") @db.VarChar(64)
  nextActionAt         DateTime?             @map("next_action_at") @db.Timestamptz(6)
  lastActivityAt       DateTime?             @map("last_activity_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities           LeadActivity[]
  assignmentBatchItems AssignmentBatchItem[]
  reassignmentRequests ReassignmentRequest[]
  collaborators        LeadCollaborator[]
  provenances          LeadProvenance[]
  ingestionReviewItems IngestionReviewItem[]

  @@index([assignedToId, status])
  @@index([assignmentMode, importBatchId])
  @@index([status, nextActionAt])
  @@index([lastName, firstName, leadCode])
  @@index([source, program, createdAt])
  @@map("leads")
}

model IngestionBatch {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(128)
  profile        String                @db.VarChar(40)
  assignmentMode String                @map("assignment_mode") @db.VarChar(32)
  actorId        String                @map("actor_id") @db.VarChar(64)
  totalCount     Int                   @map("total_count")
  createdCount   Int                   @map("created_count")
  attachedCount  Int                   @map("attached_count")
  reviewCount    Int                   @map("review_count")
  invalidCount   Int                   @map("invalid_count")
  importedAt     DateTime              @default(now()) @map("imported_at") @db.Timestamptz(6)
  provenances    LeadProvenance[]
  reviewItems    IngestionReviewItem[]
  report         ImportReport?

  @@index([importedAt(sort: Desc)])
  @@map("ingestion_batches")
}

model ImportReport {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @unique @map("job_id") @db.VarChar(128)
  batchId          String            @unique @map("batch_id") @db.Uuid
  mappingId        String            @map("mapping_id") @db.VarChar(80)
  mappingVersion   Int               @map("mapping_version")
  sourceFileSha256 String            @map("source_file_sha256") @db.Char(64)
  totalCount       Int               @map("total_count")
  createdCount     Int               @map("created_count")
  updatedCount     Int               @map("updated_count")
  ignoredCount     Int               @map("ignored_count")
  duplicateCount   Int               @map("duplicate_count")
  errorCount       Int               @map("error_count")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  batch            IngestionBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rejections       ImportRejection[]

  @@index([createdAt(sort: Desc)])
  @@map("import_reports")
}

model ImportRejection {
  id         String       @id @default(uuid()) @db.Uuid
  reportId   String       @map("report_id") @db.Uuid
  lineNumber Int          @map("line_number")
  category   String       @db.VarChar(32)
  reasonCode String       @map("reason_code") @db.VarChar(80)
  report     ImportReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@unique([reportId, lineNumber])
  @@map("import_rejections")
}

model LeadProvenance {
  id              String         @id @default(uuid()) @db.Uuid
  leadId          String         @map("lead_id") @db.Uuid
  batchId         String         @map("batch_id") @db.Uuid
  sourceType      String         @map("source_type") @db.VarChar(40)
  technicalSystem String         @map("technical_system") @db.VarChar(80)
  originalSource  String         @map("original_source") @db.VarChar(120)
  recentSource    String         @map("recent_source") @db.VarChar(120)
  campaign        String?        @db.VarChar(120)
  externalId      String?        @map("external_id") @db.VarChar(160)
  rawStatus       String?        @map("raw_status") @db.VarChar(120)
  occurredAt      DateTime?      @map("occurred_at") @db.Timestamptz(6)
  importedAt      DateTime       @default(now()) @map("imported_at") @db.Timestamptz(6)
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  batch           IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([technicalSystem, externalId])
  @@index([leadId, importedAt(sort: Desc)])
  @@index([batchId])
  @@map("lead_provenances")
}

model IngestionReviewItem {
  id         String         @id @default(uuid()) @db.Uuid
  batchId    String         @map("batch_id") @db.Uuid
  leadId     String?        @map("lead_id") @db.Uuid
  lineNumber Int            @map("line_number")
  reasonCode String         @map("reason_code") @db.VarChar(80)
  status     String         @default("PENDING") @db.VarChar(24)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  batch      IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([batchId, lineNumber])
  @@index([status, createdAt])
  @@map("ingestion_review_items")
}

model LeadCollaborator {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([leadId, userId])
  @@index([userId, active])
  @@map("lead_collaborators")
}

model ReassignmentRequest {
  id             String    @id @default(uuid()) @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  currentOwnerId String    @map("current_owner_id") @db.Uuid
  targetUserId   String    @map("target_user_id") @db.Uuid
  reason         String    @db.VarChar(500)
  moveOpenTasks  Boolean   @map("move_open_tasks")
  requestedBy    String    @map("requested_by") @db.VarChar(64)
  status         String    @default("PENDING") @db.VarChar(16)
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy      String?   @map("decided_by") @db.VarChar(64)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionReason String?   @map("decision_reason") @db.VarChar(500)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@map("reassignment_requests")
}

model AssignmentBatch {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(128)
  strategy       String                @db.VarChar(32)
  targetUserId   String?               @map("target_user_id") @db.Uuid
  actorId        String                @map("actor_id") @db.VarChar(64)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  items          AssignmentBatchItem[]

  @@index([createdAt(sort: Desc)])
  @@map("assignment_batches")
}

model AssignmentBatchItem {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  leadId         String          @map("lead_id") @db.Uuid
  selectedUserId String?         @map("selected_user_id") @db.Uuid
  outcome        String          @db.VarChar(16)
  reason         String?         @db.VarChar(80)
  batch          AssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([batchId, leadId])
  @@index([leadId])
  @@map("assignment_batch_items")
}

model LeadActivity {
  id            String    @id @default(uuid()) @db.Uuid
  leadId        String    @map("lead_id") @db.Uuid
  type          String    @db.VarChar(32)
  result        String    @db.VarChar(120)
  note          String?   @db.VarChar(2000)
  authorId      String    @map("author_id") @db.VarChar(64)
  nextActionAt  DateTime? @map("next_action_at") @db.Timestamptz(6)
  correlationId String    @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt(sort: Desc), id])
  @@map("lead_activities")
}

model AssignmentRule {
  id         String                    @id @default(uuid()) @db.Uuid
  scope      String                    @db.VarChar(16)
  matchValue String?                   @map("match_value") @db.VarChar(120)
  strategy   String                    @db.VarChar(32)
  enabled    Boolean                   @default(true)
  version    Int                       @default(1)
  cursor     Int                       @default(0)
  updatedBy  String                    @map("updated_by") @db.VarChar(64)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  candidates AssignmentRuleCandidate[]
  decisions  AssignmentDecision[]

  @@unique([scope, matchValue])
  @@index([enabled, scope])
  @@map("assignment_rules")
}

model AssignmentRuleCandidate {
  id              String         @id @default(uuid()) @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  active          Boolean        @default(true)
  suspended       Boolean        @default(false)
  excluded        Boolean        @default(false)
  capacity        Int
  activeLeadCount Int            @default(0) @map("active_lead_count")
  rule            AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([ruleId, userId])
  @@index([ruleId, active, suspended, excluded])
  @@map("assignment_rule_candidates")
}

model AssignmentDecision {
  id                   String         @id @default(uuid()) @db.Uuid
  eventKey             String         @unique @map("event_key") @db.VarChar(128)
  leadId               String         @map("lead_id") @db.Uuid
  ruleId               String         @map("rule_id") @db.Uuid
  strategy             String         @db.VarChar(32)
  selectedUserId       String         @map("selected_user_id") @db.Uuid
  candidateFingerprint String         @map("candidate_fingerprint") @db.VarChar(64)
  algorithmVersion     String         @map("algorithm_version") @db.VarChar(32)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  rule                 AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([selectedUserId, createdAt(sort: Desc)])
  @@map("assignment_decisions")
}
