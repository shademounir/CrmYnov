  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy      String?   @map("decided_by") @db.VarChar(64)
  decisionReason String?   @map("decision_reason") @db.VarChar(500)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([state, createdAt])
  @@map("lead_closure_requests")
}

model LeadMutationReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(160)
  fingerprint    String   @db.VarChar(64)
  operation      String   @db.VarChar(48)
  result         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_mutation_receipts")
}

model ReassignmentRequest {
  id             String    @id @default(uuid()) @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  currentOwnerId String    @map("current_owner_id") @db.Uuid
  targetUserId   String    @map("target_user_id") @db.Uuid
  reason         String    @db.VarChar(500)
  moveOpenTasks  Boolean   @map("move_open_tasks")
  requestedBy    String    @map("requested_by") @db.VarChar(64)
  status         String    @default("PENDING") @db.VarChar(16)
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy      String?   @map("decided_by") @db.VarChar(64)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionReason String?   @map("decision_reason") @db.VarChar(500)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(128)
  version        Int       @default(1)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@map("reassignment_requests")
}

model AssignmentBatch {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(128)
  strategy       String                @db.VarChar(32)
  targetUserId   String?               @map("target_user_id") @db.Uuid
  actorId        String                @map("actor_id") @db.VarChar(64)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  items          AssignmentBatchItem[]

  @@index([createdAt(sort: Desc)])
  @@map("assignment_batches")
}

model AssignmentBatchItem {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  leadId         String          @map("lead_id") @db.Uuid
  selectedUserId String?         @map("selected_user_id") @db.Uuid
  outcome        String          @db.VarChar(16)
  reason         String?         @db.VarChar(80)
  batch          AssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([batchId, leadId])
  @@index([leadId])
  @@map("assignment_batch_items")
}

model LeadActivity {
  id                   String    @id @default(uuid()) @db.Uuid
  leadId               String    @map("lead_id") @db.Uuid
  type                 String    @db.VarChar(32)
  result               String    @db.VarChar(120)
  note                 String?   @db.VarChar(2000)
  authorId             String    @map("author_id") @db.VarChar(64)
  nextActionAt         DateTime? @map("next_action_at") @db.Timestamptz(6)
  correlationId        String    @map("correlation_id") @db.VarChar(64)
  idempotencyKey       String?   @unique @map("idempotency_key") @db.VarChar(160)
  originalEventId      String?   @map("original_event_id") @db.Uuid
  correctionOperation  String?   @map("correction_operation") @db.VarChar(16)
  correctionReasonCode String?   @map("correction_reason_code") @db.VarChar(80)
  previousSnapshot     Json?     @map("previous_snapshot")
  replacementSnapshot  Json?     @map("replacement_snapshot")
  occurredAt           DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  lead                 Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt(sort: Desc), id])
  @@map("lead_activities")
}

model SheetImportConnector {
  id              String   @id @default(uuid()) @db.Uuid
  campusId        String   @map("campus_id") @db.Uuid
  workbookId      String   @map("workbook_id") @db.VarChar(200)
  tab             String   @db.VarChar(100)
  configuration   Json
  enabled         Boolean  @default(false)
  intervalMinutes Int      @default(15) @map("interval_minutes")
  manualRequested Boolean @default(false) @map("manual_requested")
  version         Int      @default(1)
  epoch           Int      @default(0)
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz(6)
  activeRunId     String?   @map("active_run_id") @db.Uuid
  nextRunAt       DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(6)
  updatedBy       String   @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  runs            SheetImportRun[]
  submissions     SheetImportSubmission[]
  versions        SheetImportConfigurationVersion[]

  @@unique([workbookId, tab])
  @@index([enabled, nextRunAt])
  @@map("sheet_import_connectors")
}

model SheetImportRun {
  id             String   @id @default(uuid()) @db.Uuid
  connectorId    String   @map("connector_id") @db.Uuid
  status         String   @db.VarChar(24)
  trigger        String   @db.VarChar(16)
  configurationSnapshot Json? @map("configuration_snapshot")
  configurationVersion Int? @map("configuration_version")
  sourceFailures Int @default(0) @map("source_failures")
  createdCount   Int      @default(0) @map("created_count")
  duplicateCount Int      @default(0) @map("duplicate_count")
  ignoredCount   Int      @default(0) @map("ignored_count")
  reviewCount    Int      @default(0) @map("review_count")
  errorCode      String?  @map("error_code") @db.VarChar(80)
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  connector      SheetImportConnector @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  receipts       SheetImportRunReceipt[]

  @@index([connectorId, startedAt(sort: Desc)])
  @@map("sheet_import_runs")
}

model SheetImportConfigurationVersion {
  id            String @id @default(uuid()) @db.Uuid
  connectorId   String @map("connector_id") @db.Uuid
  version       Int
  snapshot      Json
  actorId       String @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  connector     SheetImportConnector @relation(fields: [connectorId], references: [id], onDelete: Restrict)

  @@unique([connectorId, version])
  @@map("sheet_import_configuration_versions")
}

model SheetImportRunReceipt {
  id           String @id @default(uuid()) @db.Uuid
  runId        String @map("run_id") @db.Uuid
  rowKey       String @map("row_key") @db.VarChar(64)
  outcome      String @db.VarChar(24)
  errorCode    String? @map("error_code") @db.VarChar(80)
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  run          SheetImportRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, rowKey])
  @@map("sheet_import_run_receipts")
}

model SheetImportSubmission {
  id           String   @id @default(uuid()) @db.Uuid
  connectorId  String   @map("connector_id") @db.Uuid
  externalId   String   @map("external_id") @db.VarChar(128)
  fingerprint  String   @db.VarChar(64)
  outcome      String   @db.VarChar(24)
  batchId      String?  @map("batch_id") @db.Uuid
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  connector    SheetImportConnector @relation(fields: [connectorId], references: [id], onDelete: Restrict)

  @@unique([connectorId, externalId])
  @@map("sheet_import_submissions")
}

// Local Sheets identity is not an upstream submission identity.
model SheetLocalStream {
  id String @id @db.VarChar(64)
  workbookId String @map("workbook_id") @db.VarChar(200)
  sheetId Int @map("sheet_id")
  campusId String @map("campus_id") @db.Uuid
  range String @db.VarChar(64)
  headerFingerprint String @map("header_fingerprint") @db.VarChar(64)
  suspended Boolean @default(false)
  errorCode String? @map("error_code") @db.VarChar(80)
  lastObservedRow Int @map("last_observed_row")
  rows SheetLocalRow[]
  @@unique([workbookId, sheetId])
  @@map("sheet_local_streams")
}

model SheetLocalRow {
  id String @id @default(uuid()) @db.Uuid
  streamId String @map("stream_id") @db.VarChar(64)
  rowNumber Int @map("row_number")
  fingerprint String @db.VarChar(64)
  status String @db.VarChar(24)
  errorCode String? @map("error_code") @db.VarChar(80)
  batchId String? @map("batch_id") @db.Uuid
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz(6)
  lastObservedAt DateTime @default(now()) @map("last_observed_at") @db.Timestamptz(6)
  stream SheetLocalStream @relation(fields:[streamId], references:[id], onDelete:Restrict)
  @@unique([streamId,rowNumber])
  @@map("sheet_local_rows")
}

model CampusAssignmentConfiguration {
  campusId String @id @map("campus_id") @db.Uuid
  version Int
  @@map("campus_assignment_configurations")
}

model CampusAssignmentVersion {
  campusId String @map("campus_id") @db.Uuid
  version Int
  rules Json
  actorId String @map("actor_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([campusId, version])
  @@map("campus_assignment_versions")
}

model CampusAssignmentCursor {
  campusId String @map("campus_id") @db.Uuid
  version Int
  ruleId String @map("rule_id") @db.VarChar(64)
  cursor Int @default(0)
  @@id([campusId, version, ruleId])
  @@map("campus_assignment_cursors")
}

model AssignmentRule {
  id         String                    @id @default(uuid()) @db.Uuid
  scope      String                    @db.VarChar(16)
  matchValue String?                   @map("match_value") @db.VarChar(120)
  strategy   String                    @db.VarChar(32)
  enabled    Boolean                   @default(true)
  version    Int                       @default(1)
  cursor     Int                       @default(0)
  updatedBy  String                    @map("updated_by") @db.VarChar(64)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  candidates AssignmentRuleCandidate[]
  decisions  AssignmentDecision[]

  @@unique([scope, matchValue])
  @@index([enabled, scope])
  @@map("assignment_rules")
}

model AssignmentRuleCandidate {
  id              String         @id @default(uuid()) @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  active          Boolean        @default(true)
  suspended       Boolean        @default(false)
  excluded        Boolean        @default(false)
  capacity        Int
  activeLeadCount Int            @default(0) @map("active_lead_count")
  rule            AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([ruleId, userId])
  @@index([ruleId, active, suspended, excluded])
  @@map("assignment_rule_candidates")
}

model AssignmentDecision {
  id                   String         @id @default(uuid()) @db.Uuid
  eventKey             String         @unique @map("event_key") @db.VarChar(128)
  leadId               String         @map("lead_id") @db.Uuid
  ruleId               String         @map("rule_id") @db.Uuid
  strategy             String         @db.VarChar(32)
  selectedUserId       String         @map("selected_user_id") @db.Uuid
  candidateFingerprint String         @map("candidate_fingerprint") @db.VarChar(64)
  algorithmVersion     String         @map("algorithm_version") @db.VarChar(32)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  rule                 AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([selectedUserId, createdAt(sort: Desc)])
  @@map("assignment_decisions")
}
