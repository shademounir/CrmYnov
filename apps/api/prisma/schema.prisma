generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_probes")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(80)
  actorId        String?  @map("actor_id") @db.VarChar(64)
  actorRoles     String[] @map("actor_roles")
  minimizedIp    String?  @map("minimized_ip") @db.VarChar(64)
  sessionId      String?  @map("session_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.VarChar(64)
  before         Json?
  after          Json?
  result         String   @db.VarChar(32)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model Collaborator {
  id                String   @id @default(uuid()) @db.Uuid
  professionalEmail String   @unique @map("professional_email") @db.VarChar(254)
  secondaryEmail    String?  @map("secondary_email") @db.VarChar(254)
  roles             String[]
  campusId          String?  @map("campus_id") @db.VarChar(64)
  teamId            String?  @map("team_id") @db.VarChar(64)
  active            Boolean  @default(true)
  mustChangeSecret  Boolean  @default(true) @map("must_change_secret")
  credentialVersion Int      @default(1) @map("credential_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, campusId, teamId])
  @@map("collaborators")
}
