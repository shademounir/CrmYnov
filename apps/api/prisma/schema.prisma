generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemProbe {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_probes")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(80)
  actorId        String?  @map("actor_id") @db.VarChar(64)
  actorRoles     String[] @map("actor_roles")
  minimizedIp    String?  @map("minimized_ip") @db.VarChar(64)
  sessionId      String?  @map("session_id") @db.Uuid
  correlationId  String   @map("correlation_id") @db.VarChar(64)
  before         Json?
  after          Json?
  result         String   @db.VarChar(32)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model Collaborator {
  id                    String   @id @default(uuid()) @db.Uuid
  professionalEmail     String   @unique @map("professional_email") @db.VarChar(254)
  secondaryEmail        String?  @map("secondary_email") @db.VarChar(254)
  roles                 String[]
  campusId              String?  @map("campus_id") @db.VarChar(64)
  teamId                String?  @map("team_id") @db.VarChar(64)
  active                Boolean  @default(true)
  firstLoginRequired    Boolean  @default(true) @map("first_login_required")
  authenticationVersion Int      @default(1) @map("authentication_version")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, campusId, teamId])
  @@map("collaborators")
}

model Broadcast {
  id             String               @id @default(uuid()) @db.Uuid
  title          String               @db.VarChar(120)
  content        String               @db.VarChar(4000)
  internalLink   String?              @map("internal_link") @db.VarChar(500)
  authorId       String               @map("author_id") @db.VarChar(64)
  state          String               @db.VarChar(24)
  version        Int                  @default(1)
  audience       Json
  recipientCount Int                  @default(0) @map("recipient_count")
  correctionOf   String?              @map("correction_of") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  recipients     BroadcastRecipient[]

  @@index([createdAt(sort: Desc), id])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([correctionOf])
  @@map("broadcasts")
}

model BroadcastRecipient {
  broadcastId String    @map("broadcast_id") @db.Uuid
  userId      String    @map("user_id") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id])

  @@id([broadcastId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("broadcast_recipients")
}

model ChatConversation {
  id             String            @id @default(uuid()) @db.Uuid
  type           String            @db.VarChar(24)
  title          String?           @db.VarChar(120)
  leadId         String?           @map("lead_id") @db.Uuid
  leadCode       String?           @map("lead_code") @db.VarChar(32)
  createdById    String            @map("created_by_id") @db.VarChar(64)
  retentionUntil DateTime          @map("retention_until") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants   ChatParticipant[]
  messages       ChatMessage[]
  readReceipts   ChatReadReceipt[]

  @@index([updatedAt(sort: Desc), id])
  @@index([leadId, updatedAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatParticipant {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.VarChar(64)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(6)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("chat_participants")
}

model ChatMessage {
  id                 String                  @id @default(uuid()) @db.Uuid
  conversationId     String                  @map("conversation_id") @db.Uuid
  authorId           String                  @map("author_id") @db.VarChar(64)
  content            String?                 @db.VarChar(2000)
  version            Int                     @default(1)
  editedAt           DateTime?               @map("edited_at") @db.Timestamptz(6)
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation       ChatConversation        @relation(fields: [conversationId], references: [id])
  versions           ChatMessageVersion[]
  mentions           ChatMention[]
  activityConversion ChatActivityConversion?

  @@index([conversationId, createdAt, id])
  @@map("chat_messages")
}

model ChatMention {
  messageId String      @map("message_id") @db.Uuid
  userId    String      @map("user_id") @db.VarChar(64)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  message   ChatMessage @relation(fields: [messageId], references: [id])

  @@id([messageId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_mentions")
}

model ChatActivityConversion {
  id          String      @id @default(uuid()) @db.Uuid
  messageId   String      @unique @map("message_id") @db.Uuid
  leadId      String      @map("lead_id") @db.Uuid
  activityId  String      @unique @map("activity_id") @db.Uuid
  convertedBy String      @map("converted_by") @db.VarChar(64)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  message     ChatMessage @relation(fields: [messageId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@map("chat_activity_conversions")
}

model ChatMessageVersion {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  version   Int
  content   String?     @db.VarChar(2000)
  changedBy String      @map("changed_by") @db.VarChar(64)
  change    String      @db.VarChar(16)
  reason    String?     @db.VarChar(240)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  message   ChatMessage @relation(fields: [messageId], references: [id])

  @@unique([messageId, version])
  @@map("chat_message_versions")
}

model ChatReadReceipt {
  conversationId    String           @map("conversation_id") @db.Uuid
  userId            String           @map("user_id") @db.VarChar(64)
  lastReadMessageId String?          @map("last_read_message_id") @db.Uuid
  readAt            DateTime         @map("read_at") @db.Timestamptz(6)
  conversation      ChatConversation @relation(fields: [conversationId], references: [id])

  @@id([conversationId, userId])
  @@index([userId, readAt(sort: Desc)])
  @@map("chat_read_receipts")
}

model Lead {
  id                     String                           @id @default(uuid()) @db.Uuid
  leadCode               String                           @unique @map("lead_code") @db.VarChar(32)
  firstName              String                           @map("first_name") @db.VarChar(100)
  lastName               String                           @map("last_name") @db.VarChar(100)
  email                  String?                          @db.VarChar(254)
  phone                  String?                          @db.VarChar(32)
  campus                 String                           @db.VarChar(80)
  campaign               String                           @db.VarChar(120)
  educationLevel         String                           @map("education_level") @db.VarChar(80)
  program                String                           @db.VarChar(120)
  source                 String                           @db.VarChar(80)
  status                 String                           @default("PROSPECT") @db.VarChar(24)
  assignedToId           String?                          @map("assigned_to_id") @db.Uuid
  assignmentMode         String?                          @map("assignment_mode") @db.VarChar(32)
  importBatchId          String?                          @map("import_batch_id") @db.VarChar(64)
  nextActionAt           DateTime?                        @map("next_action_at") @db.Timestamptz(6)
  lastActivityAt         DateTime?                        @map("last_activity_at") @db.Timestamptz(6)
  createdAt              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities             LeadActivity[]
  assignmentBatchItems   AssignmentBatchItem[]
  reassignmentRequests   ReassignmentRequest[]
  collaborators          LeadCollaborator[]
  provenances            LeadProvenance[]
  ingestionReviewItems   IngestionReviewItem[]
  documentChecklistItems CandidateDocumentChecklistItem[]
  documents              CandidateDocument[]
  telephonyCalls         TelephonyCall[]

  @@index([assignedToId, status])
  @@index([assignmentMode, importBatchId])
  @@index([status, nextActionAt])
  @@index([lastName, firstName, leadCode])
  @@index([source, program, createdAt])
  @@map("leads")
}

model TelephonyConfiguration {
  id                     String   @id @default(uuid()) @db.Uuid
  mode                   String   @default("DISABLED") @db.VarChar(24)
  clickToCallEnabled     Boolean  @default(false) @map("click_to_call_enabled")
  inboundEnabled         Boolean  @default(false) @map("inbound_enabled")
  outboundEnabled        Boolean  @default(false) @map("outbound_enabled")
  recordingPolicy        String   @default("DISABLED") @map("recording_policy") @db.VarChar(24)
  maxCallDurationSeconds Int      @default(7200) @map("max_call_duration_seconds")
  providerConfigurationRef String? @map("provider_configuration_ref") @db.VarChar(160)
  version                Int      @default(1)
  updatedBy              String   @map("updated_by") @db.VarChar(64)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("telephony_configurations")
}

model TelephonyCall {
  id               String                      @id @default(uuid()) @db.Uuid
  provider         String                      @db.VarChar(24)
  externalId       String                      @map("external_id") @db.VarChar(128)
  direction        String                      @db.VarChar(16)
  state            String                      @db.VarChar(16)
  leadId           String?                     @map("lead_id") @db.Uuid
  phoneFingerprint String                      @map("phone_fingerprint") @db.VarChar(64)
  matchState       String                      @default("UNMATCHED") @map("match_state") @db.VarChar(24)
  requestedAt      DateTime                    @map("requested_at") @db.Timestamptz(6)
  answeredAt       DateTime?                   @map("answered_at") @db.Timestamptz(6)
  endedAt          DateTime?                   @map("ended_at") @db.Timestamptz(6)
  durationSeconds  Int?                        @map("duration_seconds")
  createdBy        String                      @map("created_by") @db.VarChar(64)
  recordingId      String?                     @map("recording_id") @db.Uuid
  lead             Lead?                       @relation(fields: [leadId], references: [id], onDelete: Restrict)
  events           TelephonyCallEvent[]
  recording        TelephonyRecordingMetadata? @relation(fields: [recordingId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([leadId, requestedAt(sort: Desc)])
  @@index([matchState, requestedAt(sort: Desc)])
  @@map("telephony_calls")
}

model TelephonyCallEvent {
  id             String        @id @default(uuid()) @db.Uuid
  callId         String        @map("call_id") @db.Uuid
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(160)
  eventType      String        @map("event_type") @db.VarChar(32)
  state          String        @db.VarChar(16)
  reasonCode     String?       @map("reason_code") @db.VarChar(64)
  actorId        String?       @map("actor_id") @db.VarChar(64)
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  call           TelephonyCall @relation(fields: [callId], references: [id], onDelete: Restrict)

  @@index([callId, occurredAt, id])
  @@map("telephony_call_events")
}

model TelephonyRecordingMetadata {
  id               String                          @id @default(uuid()) @db.Uuid
  provider         String                          @db.VarChar(24)
  state            String                          @default("UNAVAILABLE") @db.VarChar(16)
  durationSeconds  Int?
  storageReference String?                         @map("storage_reference") @db.VarChar(160)
  authorizedRoles  String[]                        @map("authorized_roles")
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  calls            TelephonyCall[]
  accessEvents     TelephonyRecordingAccessEvent[]

  @@map("telephony_recording_metadata")
}

model TelephonyRecordingAccessEvent {
  id          String                     @id @default(uuid()) @db.Uuid
  recordingId String                     @map("recording_id") @db.Uuid
  actorId     String                     @map("actor_id") @db.VarChar(64)
  outcome     String                     @db.VarChar(24)
  occurredAt  DateTime                   @default(now()) @map("occurred_at") @db.Timestamptz(6)
  recording   TelephonyRecordingMetadata @relation(fields: [recordingId], references: [id], onDelete: Restrict)

  @@index([recordingId, occurredAt(sort: Desc)])
  @@map("telephony_recording_access_events")
}

model CandidateDocumentChecklistItem {
  id              String   @id @default(uuid()) @db.Uuid
  leadId          String   @map("lead_id") @db.Uuid
  documentType    String   @map("document_type") @db.VarChar(48)
  state           String   @default("MANQUANT") @db.VarChar(24)
  requirementCode String   @map("requirement_code") @db.VarChar(80)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lead            Lead     @relation(fields: [leadId], references: [id])

  @@unique([leadId, documentType, requirementCode])
  @@index([state, documentType])
  @@map("candidate_document_checklist_items")
}

model CandidateDocument {
  id                 String                   @id @default(uuid()) @db.Uuid
  leadId             String                   @map("lead_id") @db.Uuid
  checklistItemId    String?                  @map("checklist_item_id") @db.Uuid
  documentType       String                   @map("document_type") @db.VarChar(48)
  sanitizedFileName  String                   @map("sanitized_file_name") @db.VarChar(160)
  extension          String                   @db.VarChar(12)
  declaredMime       String                   @map("declared_mime") @db.VarChar(100)
  detectedMime       String                   @map("detected_mime") @db.VarChar(100)
  byteSize           Int                      @map("byte_size")
  sha256             String                   @db.VarChar(64)
  storageReference   String                   @map("storage_reference") @db.VarChar(180)
  uploadedBy         String                   @map("uploaded_by") @db.VarChar(64)
  receivedAt         DateTime                 @default(now()) @map("received_at") @db.Timestamptz(6)
  verificationStatus String                   @default("A_VERIFIER") @map("verification_status") @db.VarChar(24)
  verifiedBy         String?                  @map("verified_by") @db.VarChar(64)
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz(6)
  refusalReasonCode  String?                  @map("refusal_reason_code") @db.VarChar(64)
  version            Int                      @default(1)
  replacedDocumentId String?                  @map("replaced_document_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  lead               Lead                     @relation(fields: [leadId], references: [id])
  events             CandidateDocumentEvent[]

  @@unique([leadId, documentType, version])
  @@index([leadId, verificationStatus, receivedAt(sort: Desc)])
  @@index([storageReference])
  @@map("candidate_documents")
}

model CandidateDocumentEvent {
  id            String            @id @default(uuid()) @db.Uuid
  documentId    String            @map("document_id") @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(48)
  actorId       String            @map("actor_id") @db.VarChar(64)
  reasonCode    String?           @map("reason_code") @db.VarChar(64)
  correlationId String            @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  document      CandidateDocument @relation(fields: [documentId], references: [id])

  @@index([documentId, occurredAt, id])
  @@map("candidate_document_events")
}

model IngestionBatch {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(128)
  profile        String                @db.VarChar(40)
  assignmentMode String                @map("assignment_mode") @db.VarChar(32)
  actorId        String                @map("actor_id") @db.VarChar(64)
  totalCount     Int                   @map("total_count")
  createdCount   Int                   @map("created_count")
  attachedCount  Int                   @map("attached_count")
  reviewCount    Int                   @map("review_count")
  invalidCount   Int                   @map("invalid_count")
  importedAt     DateTime              @default(now()) @map("imported_at") @db.Timestamptz(6)
  provenances    LeadProvenance[]
  reviewItems    IngestionReviewItem[]
  report         ImportReport?

  @@index([importedAt(sort: Desc)])
  @@map("ingestion_batches")
}

model ImportReport {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @unique @map("job_id")
  batchId          String            @unique @map("batch_id") @db.Uuid
  mappingId        String            @map("mapping_id")
  mappingVersion   Int               @map("mapping_version")
  sourceFileSha256 String            @map("source_file_sha256")
  totalCount       Int               @map("total_count")
  createdCount     Int               @map("created_count")
  updatedCount     Int               @map("updated_count")
  ignoredCount     Int               @map("ignored_count")
  duplicateCount   Int               @map("duplicate_count")
  errorCount       Int               @map("error_count")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  batch            IngestionBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rejections       ImportRejection[]

  @@index([createdAt(sort: Desc)])
  @@map("import_reports")
}

model ImportRejection {
  id         String       @id @default(uuid()) @db.Uuid
  reportId   String       @map("report_id") @db.Uuid
  lineNumber Int          @map("line_number")
  category   String
  reasonCode String       @map("reason_code")
  report     ImportReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@unique([reportId, lineNumber])
  @@map("import_rejections")
}

model LeadProvenance {
  id              String         @id @default(uuid()) @db.Uuid
  leadId          String         @map("lead_id") @db.Uuid
  batchId         String         @map("batch_id") @db.Uuid
  sourceType      String         @map("source_type") @db.VarChar(40)
  technicalSystem String         @map("technical_system") @db.VarChar(80)
  originalSource  String         @map("original_source") @db.VarChar(120)
  recentSource    String         @map("recent_source") @db.VarChar(120)
  campaign        String?        @db.VarChar(120)
  externalId      String?        @map("external_id") @db.VarChar(160)
  rawStatus       String?        @map("raw_status") @db.VarChar(120)
  occurredAt      DateTime?      @map("occurred_at") @db.Timestamptz(6)
  importedAt      DateTime       @default(now()) @map("imported_at") @db.Timestamptz(6)
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  batch           IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([technicalSystem, externalId])
  @@index([leadId, importedAt(sort: Desc)])
  @@index([batchId])
  @@map("lead_provenances")
}

model IngestionReviewItem {
  id         String         @id @default(uuid()) @db.Uuid
  batchId    String         @map("batch_id") @db.Uuid
  leadId     String?        @map("lead_id") @db.Uuid
  lineNumber Int            @map("line_number")
  reasonCode String         @map("reason_code") @db.VarChar(80)
  status     String         @default("PENDING") @db.VarChar(24)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  batch      IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([batchId, lineNumber])
  @@index([status, createdAt])
  @@map("ingestion_review_items")
}

model LeadCollaborator {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([leadId, userId])
  @@index([userId, active])
  @@map("lead_collaborators")
}

model ReassignmentRequest {
  id             String    @id @default(uuid()) @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  currentOwnerId String    @map("current_owner_id") @db.Uuid
  targetUserId   String    @map("target_user_id") @db.Uuid
  reason         String    @db.VarChar(500)
  moveOpenTasks  Boolean   @map("move_open_tasks")
  requestedBy    String    @map("requested_by") @db.VarChar(64)
  status         String    @default("PENDING") @db.VarChar(16)
  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy      String?   @map("decided_by") @db.VarChar(64)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionReason String?   @map("decision_reason") @db.VarChar(500)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
  @@map("reassignment_requests")
}

model AssignmentBatch {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(128)
  strategy       String                @db.VarChar(32)
  targetUserId   String?               @map("target_user_id") @db.Uuid
  actorId        String                @map("actor_id") @db.VarChar(64)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  items          AssignmentBatchItem[]

  @@index([createdAt(sort: Desc)])
  @@map("assignment_batches")
}

model AssignmentBatchItem {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  leadId         String          @map("lead_id") @db.Uuid
  selectedUserId String?         @map("selected_user_id") @db.Uuid
  outcome        String          @db.VarChar(16)
  reason         String?         @db.VarChar(80)
  batch          AssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([batchId, leadId])
  @@index([leadId])
  @@map("assignment_batch_items")
}

model LeadActivity {
  id            String    @id @default(uuid()) @db.Uuid
  leadId        String    @map("lead_id") @db.Uuid
  type          String    @db.VarChar(32)
  result        String    @db.VarChar(120)
  note          String?   @db.VarChar(2000)
  authorId      String    @map("author_id") @db.VarChar(64)
  nextActionAt  DateTime? @map("next_action_at") @db.Timestamptz(6)
  correlationId String    @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt(sort: Desc), id])
  @@map("lead_activities")
}

model AssignmentRule {
  id         String                    @id @default(uuid()) @db.Uuid
  scope      String                    @db.VarChar(16)
  matchValue String?                   @map("match_value") @db.VarChar(120)
  strategy   String                    @db.VarChar(32)
  enabled    Boolean                   @default(true)
  version    Int                       @default(1)
  cursor     Int                       @default(0)
  updatedBy  String                    @map("updated_by") @db.VarChar(64)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  candidates AssignmentRuleCandidate[]
  decisions  AssignmentDecision[]

  @@unique([scope, matchValue])
  @@index([enabled, scope])
  @@map("assignment_rules")
}

model AssignmentRuleCandidate {
  id              String         @id @default(uuid()) @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  active          Boolean        @default(true)
  suspended       Boolean        @default(false)
  excluded        Boolean        @default(false)
  capacity        Int
  activeLeadCount Int            @default(0) @map("active_lead_count")
  rule            AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([ruleId, userId])
  @@index([ruleId, active, suspended, excluded])
  @@map("assignment_rule_candidates")
}

model AssignmentDecision {
  id                   String         @id @default(uuid()) @db.Uuid
  eventKey             String         @unique @map("event_key") @db.VarChar(128)
  leadId               String         @map("lead_id") @db.Uuid
  ruleId               String         @map("rule_id") @db.Uuid
  strategy             String         @db.VarChar(32)
  selectedUserId       String         @map("selected_user_id") @db.Uuid
  candidateFingerprint String         @map("candidate_fingerprint") @db.VarChar(64)
  algorithmVersion     String         @map("algorithm_version") @db.VarChar(32)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  rule                 AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([selectedUserId, createdAt(sort: Desc)])
  @@map("assignment_decisions")
}
