<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>MANAGED_WITHDRAWAL_TEST</DefineConstants>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AgentModels.cs" />
    <Compile Include="../AgentEndpointPolicy.cs" />
    <Compile Include="../AgentWithdrawalPolicy.cs" />
    <Compile Include="../CrmAgentClient.cs" />
    <Compile Include="../WithdrawalContractSelfTest.cs" />
    <Compile Include="WithdrawalContract.EntryPoint.cs" />
  </ItemGroup>
</Project>
